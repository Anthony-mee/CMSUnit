		{
			"label": "Restart Next.js dev server",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"for /f \"tokens=5\" %a in ('netstat -ano ^| findstr LISTENING ^| findstr :3000') do taskkill /PID %a /F & npm run dev"
			],
			"isBackground": true,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Inspect Next.js listener",
			"type": "shell",
			"command": "Get-NetTCPConnection",
			"args": [
				"-LocalPort",
				"3000",
				"-State",
				"Listen",
				"|",
				"Select-Object",
				"-ExpandProperty",
				"OwningProcess"
			],
			"isBackground": false,
			"problemMatcher": []
		},
